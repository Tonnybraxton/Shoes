# Compose reads this file after you copy it to .env. Direct Django processes
# require environment variables; they do not automatically load .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-an-independent-random-secret-at-least-50-characters
DEBUG=true
TEST_PAYMENTS=false
SITE_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=false
TIME_ZONE=Africa/Nairobi
CURRENCY=KES
# Optional external database/cache overrides. Omit to use Compose services.
# DATABASE_URL=postgresql://user:password@host:5432/database
# REDIS_URL=redis://host:6379/0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=demo@localhost
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=false
MEDIA_ORIGIN=
PROXY_BIND_IP=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=443
# Production overlay requires an absolute directory containing
# fullchain.pem and privkey.pem, along with real HTTPS/SMTP settings above.
# TLS_CERT_DIR=/absolute/path/to/tls
