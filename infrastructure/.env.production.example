# Copy to .env.production in the repository root; keep that file out of Git.
# Generate each secret independently: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=replace-with-random-hex-password
SECRET_KEY=replace-with-an-independent-random-secret-at-least-50-characters
DEBUG=false
TEST_PAYMENTS=false
TRUST_PROXY=true
SITE_URL=https://shop.example.com
ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
PROXY_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=/etc/soleline/tls
TIME_ZONE=Africa/Nairobi
CURRENCY=KES
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Soleline <orders@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set immutable release tags before a release build; preserve previous image tags.
BACKEND_IMAGE=soleline-backend:release-id
FRONTEND_IMAGE=soleline-frontend:release-id
# DATABASE_URL and REDIS_URL may override the bundled service endpoints.
# Backup commands in DEPLOYMENT.md target the bundled PostgreSQL service.
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_QUERYSTRING_AUTH=false
MEDIA_ORIGIN=
